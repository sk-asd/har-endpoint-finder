        "request": {"method": "GET", "url": "https://shop.example.com/products", "queryString": []},
        "response": {"status": 200, "content": {"mimeType": "text/html", "size": 41000, "text": "<html>...</html>"}}
      },
      {
        "request": {"method": "GET", "url": "https://shop.example.com/static/app.css", "queryString": []},
        "response": {"status": 200, "content": {"mimeType": "text/css", "size": 12000}}
      },
      {
        "request": {"method": "GET", "url": "https://cdn.example.com/img/logo.png", "queryString": []},
        "response": {"status": 200, "content": {"mimeType": "image/png", "size": 8000}}
      },
      {
        "request": {"method": "GET", "url": "https://shop.example.com/api/v2/products?page=1&sort=price", "queryString": [{"name":"page","value":"1"},{"name":"sort","value":"price"}]},
        "response": {"status": 200, "content": {"mimeType": "application/json", "size": 9400, "text": "[{\"id\":1,\"name\":\"a\",\"price\":10},{\"id\":2,\"name\":\"b\",\"price\":20},{\"id\":3,\"name\":\"c\",\"price\":30}]"}}
      },
      {
        "request": {"method": "POST", "url": "https://shop.example.com/graphql", "queryString": []},
        "response": {"status": 200, "content": {"mimeType": "application/json", "size": 5200, "text": "{\"data\":{\"products\":{\"items\":[1,2,3]},\"total\":42}}"}}
      },
      {
        "request": {"method": "GET", "url": "https://track.ads.example.net/pixel.gif?u=123", "queryString": [{"name":"u","value":"123"}]},
        "response": {"status": 200, "content": {"mimeType": "image/gif", "size": 43}}
      }
    ]
  }
